# Copy to `.env` for local development. Do not commit `.env`.
# On Render, set these in the service's Environment tab instead.

# --- Core -------------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Leave blank locally to fall back to SQLite (db.sqlite3).
# Render supplies this automatically when a PostgreSQL instance is attached.
DATABASE_URL=

# --- Cloudinary (media storage) ---------------------------------------------
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins, scheme included, no trailing slash.
# Blank locally falls back to Vite's default dev origin (http://localhost:5173).
CORS_ALLOWED_ORIGINS=
# Optional: regexes for Vercel preview deployments, e.g.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://glorious-missions-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Email (form notifications) ---------------------------------------------
# Leave EMAIL_HOST blank to print notification emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Where contact / get-involved submissions are sent.
NOTIFY_EMAIL=
# Optional; defaults to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
